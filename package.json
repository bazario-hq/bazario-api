{
  "name": "bazario-api",
  "version": "1.0.0",
  "private": true,
  "description": "Bazario marketplace API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:make": "tsx scripts/make-migration.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:db": "docker compose -f docker-compose.test.yml up -d --wait"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.0",
    "@aws-sdk/client-s3": "3.1147.0",
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "express": "4.22.3",
    "helmet": "7.2.0",
    "jsonwebtoken": "9.0.2",
    "kysely": "0.27.4",
    "multer": "2.0.2",
    "nodemailer": "6.9.16",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "prom-client": "15.1.3",
    "sharp": "0.33.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.1.1",
    "@eslint/js": "9.14.0",
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.9.0",
    "@types/nodemailer": "6.4.16",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "eslint": "9.14.0",
    "pino-pretty": "11.3.0",
    "s3rver": "3.7.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vitest": "2.1.4"
  }
}
