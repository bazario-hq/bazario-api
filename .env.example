# Local development defaults. The compose environments in bazario-infra set these for you.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://bazario:change-me@localhost:5432/bazario
DATABASE_POOL_MAX=10
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=bazario
S3_SECRET_KEY=change-me-too
S3_BUCKET=bazario-images
S3_FORCE_PATH_STYLE=true
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Bazario <no-reply@bazario.example>"
PUBLIC_API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
